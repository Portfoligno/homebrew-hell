#!/usr/bin/env hell

-- Check for new upstream Hell releases.
-- Usage: ./scripts/check-upstream.hell
--
-- Compares the latest tag on chrisdone/hell against the version in
-- Formula/hell.rb. If a newer tag exists, outputs has-update=true
-- and upstream-tag=<tag> to $GITHUB_OUTPUT.
--
-- Requires GH_TOKEN in environment for GitHub API access.

-- Run a process, capture stdout, die on failure.
readChecked = \label -> \proc -> do
  (exitCode, stdout, stderr) <- Text.readProcess proc
  Exit.exitCode
    (IO.pure stdout)
    (\code -> Exit.die (Text.concat [label, " failed with exit code ", Show.show code, ": ", stderr]))
    exitCode

main = do
  -- Fetch the latest tag from upstream.
  -- Tags are date-based (YYYY-MM-DD) so lexicographic sort = chronologic.
  latestTagRaw <- Main.readChecked "gh api"
    (Process.proc "gh"
      [ "api"
      , "repos/chrisdone/hell/tags"
      , "--jq"
      , ".[0].name"
      ])
  let latestTag = Text.strip latestTagRaw

  -- Read the current formula version.
  formulaContents <- Text.readFile "Formula/hell.rb"
  let formulaLines = Text.splitOn "\n" formulaContents
  let versionLines = List.filter (\line -> Text.isInfixOf "version \"" line) formulaLines
  versionLine <- Maybe.maybe
    (Exit.die "Could not find version field in Formula/hell.rb")
    IO.pure
    (Maybe.listToMaybe versionLines)
  let (_before, afterPrefix) = Text.breakOn "version \"" versionLine
  let withoutPrefix = Text.drop (Text.length "version \"") afterPrefix
  let (currentVersion, _rest2) = Text.breakOn "\"" withoutPrefix

  Text.putStrLn (Text.concat ["Current formula version: ", currentVersion])
  Text.putStrLn (Text.concat ["Latest upstream tag: ", latestTag])

  -- Compare versions. Date-based tags compare lexicographically.
  githubOutput <- Environment.getEnv "GITHUB_OUTPUT"
  if Ord.gt latestTag currentVersion
    then do
      Text.putStrLn (Text.concat ["Update available: ", currentVersion, " -> ", latestTag])
      Text.appendFile githubOutput (Text.concat ["has-update=true\n", "upstream-tag=", latestTag, "\n"])
    else do
      Text.putStrLn "No update available."
      Text.appendFile githubOutput "has-update=false\n"
