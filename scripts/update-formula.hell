#!/usr/bin/env hell

-- Update Formula/hell.rb with a new version's URLs and SHA256 hashes.
-- Usage: ./scripts/update-formula.hell <version-tag>
--
-- Downloads each architecture's tarball from the GitHub Release,
-- computes its SHA256 hash, then regenerates Formula/hell.rb.
--
-- Requires GH_TOKEN in environment for downloading release assets.

-- Run a process, capture stdout, die on failure.
readChecked = \label -> \proc -> do
  (exitCode, stdout, stderr) <- Text.readProcess proc
  Exit.exitCode
    (IO.pure stdout)
    (\code -> Exit.die (Text.concat [label, " failed with exit code ", Show.show code, ": ", stderr]))
    exitCode

-- Run a process and die on failure (no stdout capture).
runChecked = \label -> \proc -> do
  result <- Process.runProcess proc
  Exit.exitCode
    (IO.pure ())
    (\code -> Exit.die (Text.concat [label, " failed with exit code ", Show.show code]))
    result

-- Download a release asset and compute its SHA256.
computeSha256 = \version -> \target -> do
  let url = Text.concat
        [ "https://github.com/Portfoligno/homebrew-hell/releases/download/"
        , version
        , "/hell-"
        , target
        , ".tar.gz"
        ]
  let filename = Text.concat ["hell-", target, ".tar.gz"]

  -- Download the asset.
  Main.runChecked (Text.concat ["download ", target])
    (Process.proc "curl" ["-fsSL", "-o", filename, url])

  -- Compute SHA256.
  shaOutput <- Main.readChecked (Text.concat ["shasum ", target])
    (Process.proc "shasum" ["-a", "256", filename])

  -- Extract just the hash (first field before the space).
  let (hash, _rest) = Text.breakOn " " (Text.strip shaOutput)
  IO.pure hash

main = do
  args <- Environment.getArgs
  version <- Maybe.maybe
    (Exit.die "Usage: update-formula.hell <version-tag>")
    IO.pure
    (Maybe.listToMaybe args)

  Text.putStrLn (Text.concat ["Updating formula to version ", version])

  -- Compute SHA256 for each architecture.
  sha256Arm <- Main.computeSha256 version "aarch64-apple-darwin"
  Text.putStrLn (Text.concat ["SHA256 (aarch64): ", sha256Arm])

  sha256Intel <- Main.computeSha256 version "x86_64-apple-darwin"
  Text.putStrLn (Text.concat ["SHA256 (x86_64): ", sha256Intel])

  -- Generate the formula.
  let formula = Text.concat
        [ "# This file is generated by scripts/update-formula.hell. DO NOT EDIT.\n"
        , "\n"
        , "class Hell < Formula\n"
        , "  desc \"Haskell-based shell scripting language\"\n"
        , "  homepage \"https://github.com/chrisdone/hell\"\n"
        , "  version \"", version, "\"\n"
        , "  license \"BSD-3-Clause\"\n"
        , "\n"
        , "  on_macos do\n"
        , "    on_arm do\n"
        , "      url \"https://github.com/Portfoligno/homebrew-hell/releases/download/", version, "/hell-aarch64-apple-darwin.tar.gz\"\n"
        , "      sha256 \"", sha256Arm, "\"\n"
        , "    end\n"
        , "    on_intel do\n"
        , "      url \"https://github.com/Portfoligno/homebrew-hell/releases/download/", version, "/hell-x86_64-apple-darwin.tar.gz\"\n"
        , "      sha256 \"", sha256Intel, "\"\n"
        , "    end\n"
        , "  end\n"
        , "\n"
        , "  def install\n"
        , "    bin.install \"hell\"\n"
        , "  end\n"
        , "\n"
        , "  test do\n"
        , "    (testpath/\"test.hell\").write <<~HELL\n"
        , "      main = Text.putStrLn \"hello from hell\"\n"
        , "    HELL\n"
        , "    assert_equal \"hello from hell\", shell_output(\"#{bin}/hell #{testpath}/test.hell\").strip\n"
        , "  end\n"
        , "end\n"
        ]

  Text.writeFile "Formula/hell.rb" formula
  Text.putStrLn "Formula updated."
